
import math

import rclpy
from rclpy.node import Node
from geometry_msgs.msg import Twist
from turtlesim.msg import Pose


class TurtleNavigator(Node):

    def __init__(self):
        super().__init__('turtle_navigator')

        # Target position in the Turtlesim window
        self.target_x = 2.0
        self.target_y = 5.0

       nano /root/turtle_ws/src/turtle_navigation/turtle_navigation/navigator.py self.pose = None
        self.goal_tolerance = 0.15

        self.cmd_pub = self.create_publisher(
            Twist, '/turtle1/cmd_vel', 10
        )

        self.pose_sub = self.create_subscription(
            Pose, '/turtle1/pose', self.pose_callback, 10
        )

        self.timer = self.create_timer(0.05, self.navigate)

        self.get_logger().info(
            f'Navigation started: target=({self.target_x}, '
            f'{self.target_y})'
        )

    def pose_callback(self, msg):
        self.pose = msg

    def navigate(self):
        if self.pose is None:
            return

        cmd = Twist()

        dx = self.target_x - self.pose.x
        dy = self.target_y - self.pose.y

        distance = math.sqrt(dx * dx + dy * dy)

        # Stop when the target is reached
        if distance < self.goal_tolerance:
            self.cmd_pub.publish(Twist())
            self.get_logger().info(
                'Target reached! Turtle stopped.'
            )
            self.timer.cancel()
            return

        # Desired heading towards the target
        desired_angle = math.atan2(dy, dx)

        # Normalize angular error to [-pi, pi]
        angle_error = math.atan2(
            math.sin(desired_angle - self.pose.theta),
            math.cos(desired_angle - self.pose.theta)
        )

        # Proportional control
        if abs(angle_error) > 0.15:
            cmd.linear.x = 0.0
            cmd.angular.z = 4.0 * angle_error
        else:
            cmd.linear.x = min(2.0, 1.5 * distance)
            cmd.angular.z = 2.0 * angle_error

        self.cmd_pub.publish(cmd)


def main(args=None):
    rclpy.init(args=args)
    node = TurtleNavigator()

    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.cmd_pub.publish(Twist())
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
